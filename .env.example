# VoxMeet — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores

# ─────────────────────────────────────────────
# GROQ — API mestra (sua chave, usada por todos os planos free/pro)
# Obtenha em: https://console.groq.com/keys
# ─────────────────────────────────────────────
VITE_GROQ_API_KEY=sua_chave_groq_aqui

# ─────────────────────────────────────────────
# FIREBASE
# ─────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# ─────────────────────────────────────────────
# STRIPE — Pagamentos com cartão e Pix
# Obtenha em: https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────
VITE_STRIPE_PUBLIC_KEY=sua_chave_publica_stripe_aqui
STRIPE_SECRET_KEY=sua_chave_secreta_stripe_aqui

# ─────────────────────────────────────────────
# NOWPAYMENTS — Pagamentos em USDT (cripto)
# Obtenha em: https://nowpayments.io/store/api-keys
# ─────────────────────────────────────────────
NOWPAYMENTS_API_KEY=sua_chave_nowpayments_aqui

# ─────────────────────────────────────────────
# CARTEIRAS USDT (seus endereços para recebimento)
# ─────────────────────────────────────────────
USDT_WALLET_TRC20=T_seu_endereco_tron_aqui
USDT_WALLET_POLYGON=0x_seu_endereco_polygon_aqui
USDT_WALLET_BEP20=0x_seu_endereco_bsc_aqui

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
VITE_APP_NAME=VoxMeet
VITE_APP_URL=https://voxmeet.app
